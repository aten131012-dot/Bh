local function spin(parent, th, speed)
    local st = new("UIStroke", {Color = WHITE, Thickness = th, Parent = parent})
    local g = new("UIGradient", {Color = ColorSequence.new({CK(0, C.RED), CK(0.33, C.PURPLE), CK(0.66, C.BLUE), CK(1, C.RED)}), Parent = st})
