local function findPrompt(egg)
    for _, v in ipairs(egg:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Name == "Pickup" then return v end
    end
    return nil
end
local function enterVolcano()
    tweenTo(CFrame.new(V_ENTER + Vector3.new(0, 5, 0)))
    task.wait(0.1)
    tweenTo(CFrame.new(V_ENTER + V_DIR * 3 + Vector3.new(0, 5, 0)))
    task.wait(0.1)
    tweenTo(CFrame.new(V_VALID + Vector3.new(0, 3, 0)))
    task.wait(0.1)
    tweenTo(CFrame.new(V_VALID + V_DIR * 3 + Vector3.new(0, 3, 0)))
    task.wait(0.2)
end
local function exitVolcano()
    tweenTo(CFrame.new(V_VALID + Vector3.new(0, 3, 0)))
    task.wait(0.1)
    tweenTo(CFrame.new(V_VALID - V_DIR * 3 + Vector3.new(0, 3, 0)))
    task.wait(0.1)
    tweenTo(CFrame.new(V_ENTER + Vector3.new(0, 5, 0)))
    task.wait(0.1)
    tweenTo(CFrame.new(V_ENTER - V_DIR * 3 + Vector3.new(0, 5, 0)))
    task.wait(0.2)
end
local function smartPickup(egg)
    local pr = findPrompt(egg)
    local part = pr and pr.Parent
    if not (part and part:IsA("BasePart")) then return end
    local volcano = VOLCANO_EGGS[egg.Name] == true
    if volcano then enterVolcano() end
    tweenTo(part.CFrame * CFrame.new(0, 3, 0))
    task.wait(0.1)
    if typeof(fireproximityprompt) == "function" then fireproximityprompt(pr, pr.HoldDuration) end
    task.wait(pr.HoldDuration + 0.85)
    if volcano then exitVolcano() end
    goHome()
end
