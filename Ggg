-- multi-select dropdown with search (uses LayoutOrder lo and lo + 1); returns a getter for the selection table
local function multiPick(list, key, entries, lo, onChange)
    local sel, open = {}, false
    local head = row(list, lo)
    tl(label(head, {Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -150, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd}), key)
    local cnt = label(head, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -36, 0, 0), Size = UDim2.fromOffset(110, 46), Text = "",
        TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.RED})
    local arrow = label(head, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.fromOffset(20, 46), Text = "+",
        TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = C.MUTED})
    local hit = button(head, {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5})

    local wrap = new("Frame", {Size = UDim2.new(1, 0, 0, 210), BackgroundTransparency = 1, Visible = false, LayoutOrder = lo + 1, Parent = list})
    local sbox = new("TextBox", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.PANEL, BackgroundTransparency = 0.3, BorderSizePixel = 0, ClearTextOnFocus = false, Text = "",
        PlaceholderColor3 = C.MUTED, TextColor3 = C.TEXT, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = wrap},
        {corner(10), stroke(C.PURPLE, 1, 0.82), new("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)})})
    reg(function() sbox.PlaceholderText = T("search") end)
    local sc = new("ScrollingFrame", {Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -36), BackgroundColor3 = C.PANEL, BackgroundTransparency = 0.4, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = C.PURPLE, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = wrap},
        {corner(12), stroke(C.PURPLE, 1, 0.82), pad(6), new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder})})

    local items = {}
    local function refresh()
        local n = 0
        for id in pairs(sel) do
            if id ~= "__all" then n = n + 1 end
        end
        cnt.Text = sel["__all"] and T("all_eggs") or (n > 0 and string.format(T("selected_n"), n) or "")
        for _, it in ipairs(items) do
            local on = sel[it.id] == true
            it.mark.BackgroundTransparency = on and 0 or 1
            it.btn.BackgroundTransparency = on and 0.6 or 0.9
        end
    end
    reg(refresh)
    for i, e in ipairs(entries) do
        local b = button(sc, {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = C.PURPLE, BackgroundTransparency = 0.9, LayoutOrder = i}, {corner(8)})
        new("Frame", {Position = UDim2.fromOffset(8, 10), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = e.col or C.MUTED, BorderSizePixel = 0, Parent = b}, {corner(4)})
        local txt = label(b, {Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -56, 1, 0), Text = e.text, Font = Enum.Font.GothamMedium, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd})
        if e.key then tl(txt, e.key) end
        local mark = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = C.RED,
            BackgroundTransparency = 1, BorderSizePixel = 0, Parent = b}, {corner(6)})
        items[#items + 1] = {id = e.id, btn = b, mark = mark, text = string.lower(e.text)}
        b.MouseButton1Click:Connect(function()
            if e.id == "__all" then
                local was = sel["__all"]
                sel = {}
                if not was then sel["__all"] = true end
            else
                sel["__all"] = nil
                if sel[e.id] then sel[e.id] = nil else sel[e.id] = true end
            end
            refresh()
            if onChange then onChange(sel) end
        end)
    end
    sbox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(sbox.Text)
        for _, it in ipairs(items) do
            it.btn.Visible = (it.id == "__all") or q == "" or string.find(it.text, q, 1, true) ~= nil
        end
    end)
    hit.MouseButton1Click:Connect(function()
        open = not open
        wrap.Visible = open
        arrow.Text = open and "-" or "+"
    end)
    return function() return sel end
