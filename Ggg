local function tweenTo(cf)
    local hrp = getHRP()
    if not hrp then return end
    local dur = math.clamp((hrp.Position - cf.Position).Magnitude / farmSpeed, 0.05, 10)
    local t = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {CFrame = cf})
    local fin = false
    local c = t.Completed:Connect(function() fin = true end)
    t:Play()
    local t0 = os.clock()
    while not fin and os.clock() - t0 < dur + 1 do task.wait() end
    c:Disconnect()
end
local function getMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        local owner = data and data:FindFirstChild("Owner")
        if owner and owner.Value == LP then return plot end
    end
    return nil
end
local function goHome()
    local plot = getMyPlot()
    local bp = plot and plot:FindFirstChildWhichIsA("BasePart", true)
    if bp then
        tweenTo(CFrame.new(bp.Position + Vector3.new(0, 5, 0)))
    elseif savedCF then
        tweenTo(savedCF)
    end
end
local function setNoclip(state)
    local ch = LP.Character
    if not ch then return end
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") and (state or p.Parent == ch) then p.CanCollide = not state end
    end
